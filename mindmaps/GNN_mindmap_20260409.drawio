        <mxCell id="node_task_3" value="&lt;div style=&#x27;text-align:center;&#x27;&gt;&lt;b&gt;消息传递&lt;/b&gt;&lt;br/&gt;⏳ 25%&lt;hr/&gt;&lt;span style=&#x27;font-size:12px;color:#666;&#x27;&gt;GNN核心机制：收集邻居特征、聚合特征，并更新自身特征的过程&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;" vertex="1" parent="1">          <mxGeometry x="200" y="350" width="260" height="100" as="geometry" />        </mxCell>
